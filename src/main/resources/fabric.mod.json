{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "Enchanted_Games"
  ],
  "contact": {
    "homepage": "${website_url}",
    "sources": "${source_url}",
    "issues": "${issue_tracker}"
  },
  "license": "${license}",
  "icon": "${icon}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "${group}.${id}.fabric.FabricClientEntry"
    ],
    "modmenu": [
      "${group}.${id}.fabric.ModMenuIntegration"
    ]
  },
  ${accesswidener_field}
  "mixins": [
    "${id}.mixins.json",
    "${id}.26_1.mixins.json",
    "${id}.26_2.mixins.json",
    "mod_compat.${id}.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": "${fabric_loader_dep_str}"
  },
  "recommends": {
    "fabric-api": "${fabric_api_dep_str}"
  }
}