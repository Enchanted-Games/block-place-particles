{
  "emitters": {
    "eg_particle_interactions:default": {
      "emitter_type": "eg_particle_interactions:particle_interactions",
      "particle": {
        "type": "eg_particle_interactions:drip/honey_drop",
        "drip_options": {
          "start_falling_ticks": 0,
          "gravity": 0.02
        }
      },
      "appearance": {
        "texture_config": {
          "sprites": [
            "eg_particle_interactions:blue_drop"
          ]
        }
      },

      "velocity_multiplier": 0.2
    },
    "eg_particle_interactions:block/broken": {

      "emitter_type": "eg_particle_interactions:particle_interactions",
      "particle": {
        "type": "eg_particle_interactions:drip/honey_drop",
        "drip_options": {
          "start_falling_ticks": 0,
          "gravity": -0.02
        }
      },
      "appearance": {
        "texture_config": {
          "sprites": [
            "eg_particle_interactions:blue_drop"
          ]
        }
      },

      "velocity_multiplier": 0.2
    },
    "eg_particle_interactions:block/placed": {

      "emitter_type": "eg_particle_interactions:particle_interactions",
      "particle": {
        "type": "eg_particle_interactions:simple/lava_pop",
        "simple_options": {
          "lifetime": {
            "min": 1,
            "max": 120
          }
        }
      },

      "velocity_multiplier": 0.2
    }
  }
}